// ===================== 核心功能：闹钟动画+蜂鸣器同步联动 =====================
void playAlarmAnimation() {
  int frame = 0;
  // 播放完整闹钟动画 + 蜂鸣器同步报警
  for(frame=0; frame<FRAME_COUNT; frame++){
    display.clearDisplay();
    display.drawBitmap(48, 16, frames[frame], FRAME_WIDTH, FRAME_HEIGHT, 1);
    display.display();
    tone(BUZZER_PIN, 4000); // 蜂鸣器高频报警音
    delay(FRAME_DELAY);
  }
  noTone(BUZZER_PIN); // 动画结束停止蜂鸣器

  // 报警结束显示四方格药盒（左上格高亮），保持 10 秒
  drawPillBox(0);
  delay(10000);
}

// ===================== 四方格药盒（均匀分布，指定格高亮） =====================
void drawPillBox(int boxIndex) {
  display.clearDisplay();
  display.setTextSize(1); // 复位文字尺寸，避免影响后续显示

  int size = 28;
  int gap  = 10;
  int startX = (SCREEN_WIDTH  - (size * 2 + gap)) / 2;
  int startY = (SCREEN_HEIGHT - (size * 2 + gap)) / 2;

  for (int row = 0; row < 2; row++) {
    for (int col = 0; col < 2; col++) {
      int x = startX + col * (size + gap);
      int y = startY + row * (size + gap);
      int idx = row * 2 + col; // 0=左上, 1=右上, 2=左下, 3=右下

      if (idx == boxIndex)
        display.fillRect(x, y, size, size, WHITE);
      else
        display.drawRect(x, y, size, size, WHITE);
    }
  }
  display.display();
}

