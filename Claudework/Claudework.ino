  // 起始播放第一个音符
  tone(BUZZER_PIN, marioNotes[0].freq);

  while (noteIndex < NOTE_COUNT) {
    unsigned long now = millis();

    // ----- 切换到下一个音符 -----
    if (now - noteStartTime >= (unsigned long)marioNotes[noteIndex].duration) {
      noTone(BUZZER_PIN);
      noteIndex++;
      if (noteIndex < NOTE_COUNT) {
        tone(BUZZER_PIN, marioNotes[noteIndex].freq);
        noteStartTime = now;
      }
    }

    // ----- 刷新爱心动画帧 -----
    if (now - lastFrameTime >= HEART_FRAME_DELAY) {
      display.clearDisplay();
      display.drawBitmap(
        48, 16,
        heartFrames[currentFrame],
        HEART_FRAME_WIDTH,
        HEART_FRAME_HEIGHT,
        1
      );
      display.display();

      currentFrame = (currentFrame + 1) % HEART_FRAME_COUNT;
      lastFrameTime = now;
    }

    yield(); // 防止 watchdog
  }

  noTone(BUZZER_PIN);
}

// ===================== 原版功能函数（100%保留） =====================
void playSuperMario() {
  int totalNotes = sizeof(melody) / sizeof(melody[0]);
  for (int i = 0; i < totalNotes; i++) {
    int noteDuration = 800 / noteDurations[i];
    tone(BUZZER_PIN, melody[i]);
    delay(noteDuration * 1.3);
    noTone(BUZZER_PIN);
    delay(50);
  }
}

void displayNumber(int num) {
  byte code = numCodes[num];
  for (int i = 0; i < 7; i++) {
    digitalWrite(segPins[i], bitRead(code, i));
  }
}

// ===================== 初始化 =====================
void setup() {
  // 硬件初始化
  for (int i = 0; i < 7; i++) pinMode(segPins[i], OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(KEY_PIN, INPUT_PULLUP);
  pinMode(COVER_PIN, INPUT_PULLUP);
  lastCoverState = digitalRead(COVER_PIN);

  // OLED初始化
  display.begin(SSD1306_SWITCHCAPVCC, SCREEN_I2C_ADDR);
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(25, 20);
  display.println("How are You?");
  display.display();
}

// ===================== 主逻辑 =====================
void loop() {
  bool currentKeyState = digitalRead(KEY_PIN);
  bool currentCoverState = digitalRead(COVER_PIN);
  displayNumber(deviceState ? 8 : 0);

  // 1. 按键自锁：按下按键 → 触发闹钟动画+蜂鸣器报警
  if (currentKeyState == LOW && lastKeyState == HIGH) {
    delay(20);
    deviceState = !deviceState;
        if(deviceState){
      playAlarmAnimation();     // 第一次：闹钟
    }else{
      playHeartAnimation();    // 第二次：爱心动画

      // 回到待机界面
      display.clearDisplay();
      display.setTextSize(1);
      display.setCursor(25, 20);
      display.println("Have a good day");
      display.display();
    }
  }

  // 2. 合盖触发：爱心动画 + 蜂鸣器（真实动画）
if (currentCoverState == LOW && lastCoverState == HIGH) {
  delay(20);
  playHeartAnimation();   // 💖 播放爱心动画 + 心跳音
}

  lastKeyState = currentKeyState;
  lastCoverState = currentCoverState;
  delay(50);
}

